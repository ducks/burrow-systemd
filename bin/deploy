#!/bin/bash
set -e

# Deploy script - updates configuration and restarts services
# Usage: sudo ./bin/deploy

echo "=== Burrow Deploy ==="
echo ""

# Check if running as root
if [ "$EUID" -ne 0 ]; then
    echo "❌ This script must be run as root (use sudo)"
    exit 1
fi

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_DIR"

# Check if .env exists
if [ ! -f .env ]; then
    echo "❌ .env file not found. Run ./bin/bootstrap first."
    exit 1
fi

# Load environment variables
source .env

# Function to generate a secure random password
generate_password() {
    openssl rand -base64 32 | tr -d "=+/" | cut -c1-32
}

# Generate missing Woodpecker credentials
if [ -z "${WOODPECKER_DB_PASSWORD:-}" ]; then
    echo "⚠️  WOODPECKER_DB_PASSWORD not found in .env, generating..."
    WOODPECKER_DB_PASSWORD=$(generate_password)
    echo "WOODPECKER_DB_PASSWORD=${WOODPECKER_DB_PASSWORD}" >> .env
    echo "✓ Added WOODPECKER_DB_PASSWORD to .env"
fi

if [ -z "${WOODPECKER_AGENT_SECRET:-}" ]; then
    echo "⚠️  WOODPECKER_AGENT_SECRET not found in .env, generating..."
    WOODPECKER_AGENT_SECRET=$(generate_password)
    echo "WOODPECKER_AGENT_SECRET=${WOODPECKER_AGENT_SECRET}" >> .env
    echo "✓ Added WOODPECKER_AGENT_SECRET to .env"
fi

if [ -z "${SCROB_DB_PASSWORD:-}" ]; then
    echo "⚠️  SCROB_DB_PASSWORD not found in .env, generating..."
    SCROB_DB_PASSWORD=$(generate_password)
    echo "SCROB_DB_PASSWORD=${SCROB_DB_PASSWORD}" >> .env
    echo "✓ Added SCROB_DB_PASSWORD to .env"
fi

# Download Woodpecker binaries if they don't exist
if [ ! -f /usr/local/bin/woodpecker-server ]; then
    echo "Downloading Woodpecker binaries..."
    WOODPECKER_VERSION="3.12.0"
    wget -O /tmp/woodpecker-server.tar.gz "https://github.com/woodpecker-ci/woodpecker/releases/download/v${WOODPECKER_VERSION}/woodpecker-server_linux_amd64.tar.gz"
    wget -O /tmp/woodpecker-agent.tar.gz "https://github.com/woodpecker-ci/woodpecker/releases/download/v${WOODPECKER_VERSION}/woodpecker-agent_linux_amd64.tar.gz"
    tar -xzf /tmp/woodpecker-server.tar.gz -C /tmp
    tar -xzf /tmp/woodpecker-agent.tar.gz -C /tmp
    chmod +x /tmp/woodpecker-server /tmp/woodpecker-agent
    mv /tmp/woodpecker-server /usr/local/bin/woodpecker-server
    mv /tmp/woodpecker-agent /usr/local/bin/woodpecker-agent
    rm /tmp/woodpecker-*.tar.gz
    echo "✓ Woodpecker binaries installed"
fi

# Check for and download latest Scrob binary if needed
echo "Checking for Scrob updates..."
SCROB_LATEST=$(curl -s https://api.github.com/repos/ducks/scrob/releases/latest | grep -oP '"tag_name": "\K(.*)(?=")')
SCROB_CURRENT=""
if [ -f /usr/local/bin/scrob ]; then
    SCROB_CURRENT=$(/usr/local/bin/scrob --version 2>/dev/null | grep -oP 'scrob \K[0-9.]+' || echo "unknown")
fi

if [ "$SCROB_CURRENT" != "${SCROB_LATEST#v}" ]; then
    echo "Updating Scrob from ${SCROB_CURRENT:-none} to ${SCROB_LATEST}..."
    systemctl stop scrob
    wget -O /usr/local/bin/scrob "https://github.com/ducks/scrob/releases/latest/download/scrob-linux-x86_64"
    chmod +x /usr/local/bin/scrob
    echo "✓ Scrob binary updated to ${SCROB_LATEST}"
else
    echo "✓ Scrob is already at latest version (${SCROB_LATEST})"
fi

# Download and deploy Scrob UI
echo "Downloading Scrob UI..."
mkdir -p /var/www/scrob-ui
wget -O /tmp/scrob-ui-dist.tar.gz "https://github.com/ducks/scrob-ui/releases/latest/download/scrob-ui-dist.tar.gz"
tar -xzf /tmp/scrob-ui-dist.tar.gz -C /var/www/scrob-ui
rm /tmp/scrob-ui-dist.tar.gz
echo "✓ Scrob UI deployed to /var/www/scrob-ui"

echo "Step 1: Updating configuration files..."
echo ""

# Update Caddyfile
cp config/Caddyfile /etc/caddy/Caddyfile
echo "✓ Updated Caddyfile"

# Update Gitea config (substitute passwords from .env)
sed -e "s|__GITEA_DB_PASSWORD__|${GITEA_DB_PASSWORD}|g" \
    -e "s|__SECRET_KEY__|${GITEA_SECRET_KEY}|g" \
    -e "s|__INTERNAL_TOKEN__|${GITEA_INTERNAL_TOKEN}|g" \
    config/gitea/app.ini > /etc/gitea/app.ini

chown gitea:gitea /etc/gitea/app.ini
chmod 640 /etc/gitea/app.ini
echo "✓ Updated Gitea configuration"

# Update Woodpecker config (substitute passwords from .env)
# Create directories and user if they don't exist
id -u woodpecker &>/dev/null || useradd -r -s /bin/bash -d /var/lib/woodpecker -m woodpecker
mkdir -p /etc/woodpecker /var/lib/woodpecker
chown -R woodpecker:woodpecker /var/lib/woodpecker /etc/woodpecker

sed -e "s|__WOODPECKER_DB_PASSWORD__|${WOODPECKER_DB_PASSWORD}|g" \
    -e "s|__WOODPECKER_AGENT_SECRET__|${WOODPECKER_AGENT_SECRET}|g" \
    -e "s|__GITEA_OAUTH_CLIENT_ID__|${GITEA_OAUTH_CLIENT_ID:-}|g" \
    -e "s|__GITEA_OAUTH_CLIENT_SECRET__|${GITEA_OAUTH_CLIENT_SECRET:-}|g" \
    config/woodpecker/server.env > /etc/woodpecker/server.env

sed -e "s|__WOODPECKER_AGENT_SECRET__|${WOODPECKER_AGENT_SECRET}|g" \
    config/woodpecker/agent.env > /etc/woodpecker/agent.env

chown woodpecker:woodpecker /etc/woodpecker/server.env /etc/woodpecker/agent.env
chmod 640 /etc/woodpecker/server.env /etc/woodpecker/agent.env
echo "✓ Updated Woodpecker configuration"

# Update Scrob config
# Create directories and user if they don't exist
id -u scrob &>/dev/null || useradd -r -s /bin/bash -d /var/lib/scrob -m scrob
mkdir -p /etc/scrob /var/lib/scrob
chown -R scrob:scrob /var/lib/scrob /etc/scrob

sed -e "s|__SCROB_DB_PASSWORD__|${SCROB_DB_PASSWORD}|g" \
    config/scrob/scrob.env > /etc/scrob/scrob.env

chown scrob:scrob /etc/scrob/scrob.env
chmod 640 /etc/scrob/scrob.env
echo "✓ Updated Scrob configuration"

# Update systemd service files
cp systemd/*.service /etc/systemd/system/
systemctl daemon-reload
echo "✓ Updated systemd services"

echo ""
echo "Step 2: Enabling and starting services..."
echo ""

# Enable and start PostgreSQL
systemctl enable postgresql
systemctl start postgresql || systemctl restart postgresql
echo "✓ PostgreSQL running"

# Create Woodpecker database if it doesn't exist
if ! sudo -u postgres psql -lqt | cut -d \| -f 1 | grep -qw woodpecker; then
    echo "Creating Woodpecker database..."
    sudo -u postgres psql -v ON_ERROR_STOP=0 <<-EOSQL
        CREATE DATABASE woodpecker;
        CREATE USER woodpecker WITH PASSWORD '${WOODPECKER_DB_PASSWORD}';
        GRANT ALL PRIVILEGES ON DATABASE woodpecker TO woodpecker;
        \c woodpecker
        GRANT ALL ON SCHEMA public TO woodpecker;
EOSQL
    echo "✓ Woodpecker database created"
fi

# Create Scrob database if it doesn't exist
if ! sudo -u postgres psql -lqt | cut -d \| -f 1 | grep -qw scrob; then
    echo "Creating Scrob database..."
    sudo -u postgres psql -v ON_ERROR_STOP=0 <<-EOSQL
        CREATE DATABASE scrob;
        CREATE USER scrob WITH PASSWORD '${SCROB_DB_PASSWORD}';
        GRANT ALL PRIVILEGES ON DATABASE scrob TO scrob;
        \c scrob
        GRANT ALL ON SCHEMA public TO scrob;
EOSQL
    echo "✓ Scrob database created"
fi

# Create GoatCounter directories if they don't exist
mkdir -p /var/lib/goatcounter-jg /var/lib/goatcounter-dv /var/lib/goatcounter-gv
chown -R goatcounter:goatcounter /var/lib/goatcounter-jg /var/lib/goatcounter-dv /var/lib/goatcounter-gv 2>/dev/null || true
echo "✓ GoatCounter directories ready"

# Enable and start base services
for service in gitea goatcounter-jg goatcounter-dv goatcounter-gv scrob caddy; do
    systemctl enable $service
    systemctl restart $service

    # Wait a moment and check status
    sleep 1
    if systemctl is-active --quiet $service; then
        echo "✓ $service running"
    else
        echo "⚠️  $service failed to start"
        echo "   Check logs: journalctl -u $service -n 50"
    fi
done

# Start Woodpecker services if OAuth is configured
if [ -n "${GITEA_OAUTH_CLIENT_ID:-}" ] && [ -n "${GITEA_OAUTH_CLIENT_SECRET:-}" ]; then
    echo ""
    echo "Starting Woodpecker CI services..."
    for service in woodpecker-server woodpecker-agent; do
        systemctl enable $service
        systemctl restart $service

        sleep 1
        if systemctl is-active --quiet $service; then
            echo "✓ $service running"
        else
            echo "⚠️  $service failed to start"
            echo "   Check logs: journalctl -u $service -n 50"
        fi
    done
else
    echo ""
    echo "⚠️  Woodpecker CI not started - OAuth credentials not configured"
    echo "   Add GITEA_OAUTH_CLIENT_ID and GITEA_OAUTH_CLIENT_SECRET to .env"
    echo "   Then run ./bin/deploy again"
fi

echo ""
echo "=== Deployment Complete ==="
echo ""
echo "Services status:"
if [ -n "${GITEA_OAUTH_CLIENT_ID:-}" ] && [ -n "${GITEA_OAUTH_CLIENT_SECRET:-}" ]; then
    systemctl status gitea caddy goatcounter-jg goatcounter-dv goatcounter-gv scrob woodpecker-server woodpecker-agent --no-pager | grep -E "●|Active:"
else
    systemctl status gitea caddy goatcounter-jg goatcounter-dv goatcounter-gv scrob --no-pager | grep -E "●|Active:"
fi
echo ""
echo "Services available at:"
echo "  - https://code.jakegoldsborough.com (Gitea)"
echo "  - https://scrob.jakegoldsborough.com (Scrob API)"
echo "  - https://ui.scrob.jakegoldsborough.com (Scrob UI)"
if [ -n "${GITEA_OAUTH_CLIENT_ID:-}" ] && [ -n "${GITEA_OAUTH_CLIENT_SECRET:-}" ]; then
    echo "  - https://ci.jakegoldsborough.com (Woodpecker CI)"
fi
echo "  - https://stats.jakegoldsborough.com (GoatCounter)"
echo "  - https://stats.date-ver.com (GoatCounter)"
echo "  - https://stats.gnarlyvoid.com (GoatCounter)"
echo ""
echo "To view logs:"
echo "  journalctl -u gitea -f"
echo "  journalctl -u caddy -f"
echo "  journalctl -u goatcounter-jg -f"
echo "  journalctl -u goatcounter-dv -f"
echo "  journalctl -u goatcounter-gv -f"
echo "  journalctl -u scrob -f"
if [ -n "${GITEA_OAUTH_CLIENT_ID:-}" ] && [ -n "${GITEA_OAUTH_CLIENT_SECRET:-}" ]; then
    echo "  journalctl -u woodpecker-server -f"
    echo "  journalctl -u woodpecker-agent -f"
fi
echo ""
