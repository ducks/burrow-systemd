#!/bin/bash
set -e

# Update script - checks and applies updates for infrastructure services
# Usage:
#   sudo ./bin/update check           - Check for available updates
#   sudo ./bin/update apply           - Apply all available updates
#   sudo ./bin/update apply [service] - Apply update for specific service

echo "=== Burrow Update ==="
echo ""

# Check if running as root
if [ "$EUID" -ne 0 ]; then
    echo "❌ This script must be run as root (use sudo)"
    exit 1
fi

MODE="${1:-check}"
SERVICE="${2:-all}"

# Colors for output
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m' # No Color

# Helper function for safe downloads
safe_download() {
    local url="$1"
    local dest="$2"
    local name="${3:-file}"

    if ! wget -q -O "$dest" "$url"; then
        echo -e "${RED}⚠️  Failed to download $name${NC}"
        rm -f "$dest"
        return 1
    fi
    return 0
}

check_gitea() {
    echo -n "Gitea: "
    CURRENT=$(/usr/local/bin/gitea --version 2>/dev/null | grep -oP '(?<=version )[0-9.]+' || echo "unknown")
    LATEST=$(curl -s https://api.github.com/repos/go-gitea/gitea/releases/latest | grep -oP '"tag_name": "v\K[^"]+')

    if [ "$CURRENT" = "$LATEST" ]; then
        echo -e "${GREEN}${CURRENT} (up to date)${NC}"
        return 1
    else
        echo -e "${YELLOW}${CURRENT} -> ${LATEST} (update available)${NC}"
        return 0
    fi
}

update_gitea() {
    echo "Updating Gitea..."
    CURRENT=$(/usr/local/bin/gitea --version 2>/dev/null | grep -oP '(?<=version )[0-9.]+' || echo "unknown")
    LATEST=$(curl -s https://api.github.com/repos/go-gitea/gitea/releases/latest | grep -oP '"tag_name": "v\K[^"]+')

    if [ "$CURRENT" = "$LATEST" ]; then
        echo "✓ Gitea is already up to date (${CURRENT})"
        return
    fi

    echo "Downloading Gitea ${LATEST}..."
    if ! safe_download "https://dl.gitea.com/gitea/${LATEST}/gitea-${LATEST}-linux-amd64" "/tmp/gitea" "Gitea ${LATEST}"; then
        return 1
    fi

    systemctl stop gitea
    chmod +x /tmp/gitea
    mv /tmp/gitea /usr/local/bin/gitea
    systemctl start gitea
    echo "✓ Gitea updated to ${LATEST}"
}

check_goatcounter() {
    echo -n "GoatCounter: "
    CURRENT=$(/usr/local/bin/goatcounter version 2>/dev/null | grep -oP 'version \K[0-9.]+' || echo "unknown")
    LATEST=$(curl -s https://api.github.com/repos/arp242/goatcounter/releases/latest | grep -oP '"tag_name": "v\K[^"]+')

    if [ "$CURRENT" = "$LATEST" ]; then
        echo -e "${GREEN}${CURRENT} (up to date)${NC}"
        return 1
    else
        echo -e "${YELLOW}${CURRENT} -> ${LATEST} (update available)${NC}"
        return 0
    fi
}

update_goatcounter() {
    echo "Updating GoatCounter..."
    CURRENT=$(/usr/local/bin/goatcounter version 2>/dev/null | grep -oP 'version \K[0-9.]+' || echo "unknown")
    LATEST=$(curl -s https://api.github.com/repos/arp242/goatcounter/releases/latest | grep -oP '"tag_name": "v\K[^"]+')

    if [ "$CURRENT" = "$LATEST" ]; then
        echo "✓ GoatCounter is already up to date (${CURRENT})"
        return
    fi

    echo "Downloading GoatCounter ${LATEST}..."
    if ! safe_download "https://github.com/arp242/goatcounter/releases/download/v${LATEST}/goatcounter-v${LATEST}-linux-amd64.gz" "/tmp/goatcounter.gz" "GoatCounter ${LATEST}"; then
        return 1
    fi

    gunzip -f /tmp/goatcounter.gz
    systemctl stop goatcounter-jg goatcounter-dv goatcounter-gv
    chmod +x /tmp/goatcounter
    mv /tmp/goatcounter /usr/local/bin/goatcounter
    systemctl start goatcounter-jg goatcounter-dv goatcounter-gv
    echo "✓ GoatCounter updated to ${LATEST}"
}

check_woodpecker() {
    echo -n "Woodpecker: "
    CURRENT=$(/usr/local/bin/woodpecker-server --version 2>/dev/null | grep -oP '(?<=version )[0-9.]+' || echo "unknown")
    LATEST=$(curl -s https://api.github.com/repos/woodpecker-ci/woodpecker/releases/latest | grep -oP '"tag_name": "v\K[^"]+')

    if [ "$CURRENT" = "$LATEST" ]; then
        echo -e "${GREEN}${CURRENT} (up to date)${NC}"
        return 1
    else
        echo -e "${YELLOW}${CURRENT} -> ${LATEST} (update available)${NC}"
        return 0
    fi
}

update_woodpecker() {
    echo "Updating Woodpecker..."
    CURRENT=$(/usr/local/bin/woodpecker-server --version 2>/dev/null | grep -oP '(?<=version )[0-9.]+' || echo "unknown")
    LATEST=$(curl -s https://api.github.com/repos/woodpecker-ci/woodpecker/releases/latest | grep -oP '"tag_name": "v\K[^"]+')

    if [ "$CURRENT" = "$LATEST" ]; then
        echo "✓ Woodpecker is already up to date (${CURRENT})"
        return
    fi

    echo "Downloading Woodpecker ${LATEST}..."
    if ! safe_download "https://github.com/woodpecker-ci/woodpecker/releases/download/v${LATEST}/woodpecker-server_linux_amd64" "/tmp/woodpecker-server" "Woodpecker server ${LATEST}"; then
        return 1
    fi
    if ! safe_download "https://github.com/woodpecker-ci/woodpecker/releases/download/v${LATEST}/woodpecker-agent_linux_amd64" "/tmp/woodpecker-agent" "Woodpecker agent ${LATEST}"; then
        rm -f /tmp/woodpecker-server
        return 1
    fi

    systemctl stop woodpecker-server woodpecker-agent 2>/dev/null || true
    chmod +x /tmp/woodpecker-server /tmp/woodpecker-agent
    mv /tmp/woodpecker-server /usr/local/bin/woodpecker-server
    mv /tmp/woodpecker-agent /usr/local/bin/woodpecker-agent
    systemctl start woodpecker-server woodpecker-agent 2>/dev/null || true
    echo "✓ Woodpecker updated to ${LATEST}"
}

check_scrob() {
    echo -n "Scrob: "
    CURRENT=$(/usr/local/bin/scrob --version 2>/dev/null | grep -oP 'scrob \K[0-9.]+' || echo "unknown")
    LATEST=$(curl -s https://api.github.com/repos/ducks/scrob/releases/latest | grep -oP '"tag_name": "v\K[^"]+')

    if [ "$CURRENT" = "$LATEST" ]; then
        echo -e "${GREEN}${CURRENT} (up to date)${NC}"
        return 1
    else
        echo -e "${YELLOW}${CURRENT} -> ${LATEST} (update available)${NC}"
        return 0
    fi
}

update_scrob() {
    echo "Updating Scrob..."
    CURRENT=$(/usr/local/bin/scrob --version 2>/dev/null | grep -oP 'scrob \K[0-9.]+' || echo "unknown")
    LATEST=$(curl -s https://api.github.com/repos/ducks/scrob/releases/latest | grep -oP '"tag_name": "v\K[^"]+')

    if [ "$CURRENT" = "$LATEST" ]; then
        echo "✓ Scrob is already up to date (${CURRENT})"
        return
    fi

    echo "Downloading Scrob ${LATEST}..."
    if ! safe_download "https://github.com/ducks/scrob/releases/download/v${LATEST}/scrob-linux-x86_64" "/usr/local/bin/scrob" "Scrob ${LATEST}"; then
        return 1
    fi

    chmod +x /usr/local/bin/scrob
    systemctl restart scrob
    echo "✓ Scrob updated to ${LATEST}"
}

update_caddy() {
    echo "Updating Caddy..."

    # Detect package manager
    if command -v pacman &> /dev/null; then
        echo "Updating via pacman..."
        pacman -Sy caddy
    elif command -v apt-get &> /dev/null; then
        echo "Updating via apt..."
        apt-get update
        apt-get install --only-upgrade caddy
    elif command -v dnf &> /dev/null; then
        echo "Updating via dnf..."
        dnf upgrade caddy
    else
        echo "⚠️  Could not detect package manager"
        return 1
    fi

    # Reload Caddy
    systemctl restart caddy

    echo "✓ Caddy updated"
}

# Main logic
if [ "$MODE" = "check" ]; then
    echo "Checking for updates..."
    echo ""

    UPDATES_AVAILABLE=0
    check_gitea && UPDATES_AVAILABLE=1
    check_goatcounter && UPDATES_AVAILABLE=1
    check_woodpecker && UPDATES_AVAILABLE=1
    check_scrob && UPDATES_AVAILABLE=1

    echo ""
    if [ $UPDATES_AVAILABLE -eq 1 ]; then
        echo "To apply updates, run: sudo ./bin/update apply"
    else
        echo "✓ All services are up to date!"
    fi

elif [ "$MODE" = "apply" ]; then
    case "$SERVICE" in
        gitea)
            update_gitea
            ;;
        goatcounter)
            update_goatcounter
            ;;
        woodpecker)
            update_woodpecker
            ;;
        scrob)
            update_scrob
            ;;
        caddy)
            update_caddy
            ;;
        all)
            check_gitea && update_gitea || true
            echo ""
            check_goatcounter && update_goatcounter || true
            echo ""
            check_woodpecker && update_woodpecker || true
            echo ""
            check_scrob && update_scrob || true
            echo ""
            update_caddy || true
            ;;
        *)
            echo "❌ Unknown service: $SERVICE"
            echo ""
            echo "Usage: sudo ./bin/update apply [service]"
            echo "  service: gitea, goatcounter, woodpecker, scrob, caddy, or all (default)"
            exit 1
            ;;
    esac

    echo ""
    echo "=== Update Complete ==="
    echo ""
    echo "Service status:"
    systemctl status gitea caddy goatcounter-jg goatcounter-dv goatcounter-gv woodpecker-server woodpecker-agent scrob --no-pager | grep -E "●|Active:"
    echo ""

else
    echo "❌ Unknown mode: $MODE"
    echo ""
    echo "Usage:"
    echo "  sudo ./bin/update check           - Check for available updates"
    echo "  sudo ./bin/update apply           - Apply all available updates"
    echo "  sudo ./bin/update apply [service] - Apply update for specific service"
    exit 1
fi
