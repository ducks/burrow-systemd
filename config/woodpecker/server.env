# Woodpecker Server Configuration

# Server settings
WOODPECKER_HOST=https://ci.jakegoldsborough.com
WOODPECKER_SERVER_ADDR=:8000
WOODPECKER_GRPC_ADDR=:9000

# Database
WOODPECKER_DATABASE_DRIVER=postgres
WOODPECKER_DATABASE_DATASOURCE=postgres://woodpecker:__WOODPECKER_DB_PASSWORD__@localhost:5432/woodpecker?sslmode=disable

# Gitea OAuth integration
WOODPECKER_GITEA=true
WOODPECKER_GITEA_URL=https://code.jakegoldsborough.com
WOODPECKER_GITEA_CLIENT=__GITEA_OAUTH_CLIENT_ID__
WOODPECKER_GITEA_SECRET=__GITEA_OAUTH_CLIENT_SECRET__

# Agent secret (shared with agents)
WOODPECKER_AGENT_SECRET=__WOODPECKER_AGENT_SECRET__

# Admin users (comma-separated Gitea usernames)
WOODPECKER_ADMIN=

# Logging
WOODPECKER_LOG_LEVEL=info
